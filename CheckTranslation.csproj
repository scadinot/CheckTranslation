<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\CheckTranslation.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.8.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Markdig" Version="0.38.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="OpenAI" Version="2.8.0" />
    <PackageReference Include="Polly" Version="8.5.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Forms\MainForm.resx">
      <LogicalName>CheckTranslation.MainForm.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\ConfigForm.resx">
      <LogicalName>CheckTranslation.ConfigForm.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\GlossaryForm.resx">
      <LogicalName>CheckTranslation.GlossaryForm.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\GlossaryExtractionDialog.resx">
      <LogicalName>CheckTranslation.GlossaryExtractionDialog.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Forms\MainForm.LayoutPersistence.resx" />
    <EmbeddedResource Remove="Forms\ManualRefreshSupport.resx" />
    <EmbeddedResource Remove="Forms\VerificationScoreFilterSupport.resx" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Input.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>